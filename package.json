{
    "name": "com.pksimeonov.denon-receiver",
    "version": "1.0.0",
    "description": "Stream Deck plugin to control Denon/Marantz receivers (volume, power, source, Dynamic Volume, Dynamic EQ, subwoofer level) over the network. Requires a HEOS-capable model.",
    "author": "pksimeonov",
    "homepage": "https://github.com/pksimeonov/streamdeck-denon-receiver",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.pksimeonov.denon-receiver\"",
        "pack": "streamdeck pack --no-update-check -o release com.pksimeonov.denon-receiver.sdPlugin",
        "validate": "streamdeck validate com.pksimeonov.denon-receiver.sdPlugin",
        "link": "streamdeck link com.pksimeonov.denon-receiver.sdPlugin",
        "restart": "streamdeck restart com.pksimeonov.denon-receiver"
    },
    "type": "module",
    "devDependencies": {
        "@babel/core": "^7.25.8",
        "@babel/plugin-proposal-decorators": "^7.25.7",
        "@babel/preset-env": "^7.25.8",
        "@elgato/cli": "^1.0.0",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^28.0.0",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@types/node": "~20.15.0",
        "rollup": "^4.0.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^1.0.0",
        "@xmldom/xmldom": "^0.9.4",
        "telnet-stream": "^1.1.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.28.1"
    }
}
